import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

void main() {
  runApp(const AgriSmartApp());
}

class AgriSmartData extends ChangeNotifier {
  double _soilMoisture = 65.0;
  double _temperature = 30.0;
  double _humidity = 70.0;
  String _cropHealth = 'Good';
  bool _pumpOn = false;

  double get soilMoisture => _soilMoisture;
  double get temperature => _temperature;
  double get humidity => _humidity;
  String get cropHealth => _cropHealth;
  bool get pumpOn => _pumpOn;

  set pumpOn(bool value) {
    _pumpOn = value;
    notifyListeners();
  }
}

class AgriSmartApp extends StatelessWidget {
  const AgriSmartApp({super.key});

  @override
  Widget build(BuildContext context) {
    return ChangeNotifierProvider<AgriSmartData>(
      create: (context) => AgriSmartData(),
      builder: (context, child) => MaterialApp(
        debugShowCheckedModeBanner: false,
        title: 'Smart Agriculture',
        theme: ThemeData(
          colorSchemeSeed: Colors.green,
          useMaterial3: true,
        ),
        home: const AgricultureHome(),
      ),
    );
  }
}

class AgricultureHome extends StatelessWidget {
  const AgricultureHome({super.key});

  @override
  Widget build(BuildContext context) {
    final data = Provider.of<AgriSmartData>(context);

    return Scaffold(
      appBar: AppBar(
        title: const Text(
          '🌱 AgriSmart',
          style: TextStyle(fontWeight: FontWeight.bold),
        ),
        backgroundColor: Colors.green,
        foregroundColor: Colors.white,
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'Welcome, Farmer!',
              style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold),
            ),
            const Text(
              'Monitor your farm smartly.',
              style: TextStyle(color: Colors.grey),
            ),
            const SizedBox(height: 20),
            const Text(
              'Farm Monitoring',
              style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
            ),
            GridView.count(
              shrinkWrap: true,
              physics: const NeverScrollableScrollPhysics(),
              crossAxisCount: 2,
              mainAxisSpacing: 10,
              crossAxisSpacing: 10,
              children: [
                _SensorCard('Soil Moisture', '${data.soilMoisture.toInt()}%', Icons.water_drop),
                _SensorCard('Temperature', '${data.temperature.toInt()}°C', Icons.thermostat),
                _SensorCard('Humidity', '${data.humidity.toInt()}%', Icons.cloud),
                _SensorCard('Crop Health', data.cropHealth, Icons.eco),
              ],
            ),
            const SizedBox(height: 20),
            const Text(
              'Smart Irrigation System',
              style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
            ),
            Card(
              child: ListTile(
                leading: const Icon(Icons.water, color: Colors.blue, size: 35),
                title: const Text('Water Pump'),
                subtitle: Text(data.pumpOn ? 'Pump is ON' : 'Pump is OFF'),
                trailing: Switch(
                  value: data.pumpOn,
                  activeColor: Colors.green,
                  onChanged: (value) => data.pumpOn = value,
                ),
              ),
            ),
            const SizedBox(height: 20),
            const Text(
              'Recommended Crops',
              style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
            ),
            const Card(
              child: ListTile(
                leading: Icon(Icons.grass, color: Colors.green),
                title: Text('Rice'),
                subtitle: Text('Suitable crop for water-rich fields'),
              ),
            ),
            const Card(
              child: ListTile(
                leading: Icon(Icons.agriculture, color: Colors.orange),
                title: Text('Groundnut'),
                subtitle: Text('Suitable for well-drained soil'),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class _SensorCard extends StatelessWidget {
  final String title;
  final String value;
  final IconData icon;

  const _SensorCard(this.title, this.value, this.icon);

  @override
  Widget build(BuildContext context) {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(12),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(icon, size: 35, color: Colors.green),
            const SizedBox(height: 10),
            Text(title, style: const TextStyle(fontWeight: FontWeight.bold)),
            const SizedBox(height: 8),
            Text(value, style: const TextStyle(fontSize: 20)),
          ],
        ),
      ),
    );
  }
}

